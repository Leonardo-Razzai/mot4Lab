LOOP

COMMENT
Load MOT, switch off B field

ENDCOMMENT

INIT
Trigger = Off                                                      (0)
Trigger CCD = Off						(1) 
MOT B Field = Off						(14)
shim X = 0.0 mA                                                 (23)
shim Y = 0.0 mA                                                 (24)
shim Z = 0.0 mA                                                 (25)

ENDINIT

INNER
+1s		    MOT B Field = Off				(14)
+1ms        shim Z = -500.0 mA               (25)
+1ms		AOM Amp = [700]					(41)
+1ms		MOT B Field = On				(14)
+1s	    Trigger CCD = On				    (1)
+50us		AOM Amp = [700]					(41)
+300us		AOM Amp = [0]					(41)
+10us		Trigger CCD = Off               (1)
+10us		MOT B Field = Off				(14)
+10ms		AOM Amp = [700]					(41)
+10ms       shim Z = 0.0 mA                 (25)
+10ms		Trigger CCD = Off               (1)
ENDINNER

ITERATIONS 1

ENDLOOP
