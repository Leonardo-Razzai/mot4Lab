LOOP

COMMENT
Load ODT from MOT
ENDCOMMENT

INIT
Trigger = Off                                                          (0)
Trigger CCD = Off                                                      (1)
MOT B Field = Off                                                      (14)
shim X = 0.0 mA                                                        (23)
shim Y = 0.0 mA                                                        (24)
shim Z = 0.0 mA                                                        (25)
ODT Freq = 110000000.0 Hz                                              (42)
ODT Amp = [0]                                                          (43)
ENDINIT

INNER
+1s             Ref Cool Freq = 10000000.0 Hz                                (32)
+1ms            AOM Amp = [700]                                              (41)
+50us           ODT Amp = [400]                                              (43)
+1s             MOT B Field = On                                             (14)
+5s             shim X = -800 mA                                             (23)
+50us           shim Y = -800 mA                                             (24)
+50us           shim Z = -250 mA                                             (25)
+0.5s           MOT B Field = Off                                            (14)
+50us           Trigger = On                                                 (0)
+<TDELAY>us     shim X = 20.0 mA                                             (23)
+50us           shim Y = -800.0 mA                                           (24)
+50us           shim Z = -250.0 mA                                           (25)
+50us           RAMP Ref Cool Freq TO 10900000.0 Hz IN 5ms (20 STEPS)        (32)
+10.1ms         AOM Amp = [0]                                                (41)
+50us           Ref Cool Freq = 10000000.0 Hz                                (32)
+40ms           Trigger CCD = On                                             (1)
+50us           AOM Amp = [700]                                              (41)
+500us          AOM Amp = [0]                                                (41)
+20ms           Trigger CCD = Off                                            (1)
+1ms            AOM Amp = [700]                                              (41)
+20ms           Ref Cool Freq = 10000000.0 Hz                                (32)
+50us           shim X = 0.0 mA                                              (23)
+50us           shim Y = 0.0 mA                                              (24)
+50us           shim Z = 0.0 mA                                              (25)
+50us           ODT Amp = [0]                                                (43)
ENDINNER

ITERATIONS 1

ENDLOOP
