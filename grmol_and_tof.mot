LOOP

COMMENT
Load MOT, switch off B field

ENDCOMMENT

INIT
Trigger = Off                                                      (0)
Trigger CCD = Off						(1) 
MOT B Field = Off						(14)
shim X = 0.0 mA                                                 (23)
shim Y = 0.0 mA                                                 (24)
shim Z = 0.0 mA                                                 (25)

ENDINIT

INNER
+1s			Ref Cool Freq = 10000000.0 Hz                    (32)
+1ms		Ref Cool Rep = 10000000.0 Hz                    (30)
+1ms		AOM Amp = [700]					(41)
+1s			MOT B Field = On				(14)
+5s			MOT B Field = Off				(14)
+50us		Trigger = On				(0)
+50us		shim X = 20.0 mA                                 (23)
+50us		shim Y = -800.0 mA                             (24)
+50us		shim Z = -260.0 mA                              (25)
+50us		Ref Rep Freq = 10111900.0 Hz                  (30)
+50us		RAMP Ref Cool Freq TO 11700000.0 Hz IN 5ms (20 STEPS)                  (32)
+15.05ms	AOM Amp = [0]					(41)
+100us		Ref Cool Freq = 10000000.0 Hz                    (32)
+100us		Ref Rep Freq = 10000000.0 Hz                    (30)
+25.0ms	    Trigger CCD = On				(1)
+50us		AOM Amp = [700]					(41)
+50us		AOM Amp = [0]					(41)
+20ms		Trigger CCD = Off                                   (1)
+1ms		AOM Amp = [700]					(41)
+20ms		Ref Cool Freq = 10000000.0 Hz                    (32)
+1ms		Ref Rep Freq = 10000000.0 Hz                    (30)
+50us		shim X = 0.0 mA                                 (23)
+50us		shim Y = 0.0 mA                                 (24)
+50us		shim Z = 0.0 mA                                 (25)
ENDINNER

ITERATIONS 1

ENDLOOP
