#include <arv.h>
#include <fitsio.h>
#include <stdlib.h>
#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <getopt.h>

#define STRSZ 100

int main (int argc, char **argv)
{
  ArvCamera *camera;
  ArvBuffer *buffer;
  GError *error = NULL;
  char c, *fname=NULL, *cmt=NULL;
  const char **tn;
  double lo,hi,gv,ev;
  gint w,h;
  guint n,i;
  size_t sz;
  int info=0,arm=0,gain=0,exposure=0,jpg=0,nimg=1;
  
  fitsfile *fptr;
  int status=0;
  long naxes[2],npix;
  long fpixels[2]={1,1};
  char aux[STRSZ];
  void *data;
  FILE *fp;
  
  while(1) 
    {  
      c=getopt(argc,argv,"is:g:t:af:jc:n:h?");
      if (c == -1)
	break;
  
      switch(c) 
	{
	case 'i':
	  info++;
	  break;
	  
	case 'g':
	  gain++;
	  gv=strtod(optarg,NULL);
	  break;
		  
	case 't':
	  exposure++;
	  ev=strtod(optarg,NULL);
	  break;
	  
	case 'a':
	  arm++;
	  break;
	  
	case 'n':
	  nimg=strtol(optarg,NULL,10);
	  if(nimg<1)
	    nimg=1;
	  break;

	case 'f':
	  fname = strdup(optarg);
	  break;

	case 'j':
	  jpg++;
	  break;

	case 'c':
	  cmt = strdup(optarg);
	  break;

	case '?':
	case 'h':
	default:
	  fprintf(stderr,"Usage: %s <options>\n",argv[0]);
	  fprintf(stderr,"Valid options are:\n");
	  fprintf(stderr,"\t-help -?      : this message\n");
	  fprintf(stderr,"\t-i            : print ccd info\n");
	  fprintf(stderr,"\t-g n          : set gain to n dB\n");
	  fprintf(stderr,"\t-t n          : set exposure time to n us\n");
	  fprintf(stderr,"\t-a            : arm external trigger\n");
	  fprintf(stderr,"\t-n n          : acquire n images\n");
	  fprintf(stderr,"\t-f fname      : read frame and save to fname.fits file\n");
	  fprintf(stderr,"\t-j            : use with -f to create also fname.jpg\n");
	  fprintf(stderr,"\t-c \"a comment\"    : add comments to FITS file. Use quotes if there are spaces\n");

	  return EXIT_SUCCESS;
	}
    }
  
  camera=arv_camera_new(NULL,&error);
  if(ARV_IS_CAMERA(camera))
    {
      if(info)
	{
	  printf("Camera %s\n", arv_camera_get_model_name(camera,&error));

	  arv_camera_get_sensor_size(camera,&w,&h,&error);
	  printf("\nSensor Size %d x %d\n",w,h);
	  
	  printf("\nGain: %f\n",arv_camera_get_gain(camera,&error));
	  arv_camera_get_gain_bounds(camera,&lo,&hi,&error);
	  printf("Gain limits: %f .. %f dB\n",lo,hi);

	  printf("\nExposure time: %f\n",arv_camera_get_exposure_time(camera,&error));
	  arv_camera_get_exposure_time_bounds(camera,&lo,&hi,&error);
	  printf("Exposure limits: %f .. %f us\n",lo,hi);

	  printf("\nTrigger modes:\n");
	  tn=arv_camera_dup_available_triggers(camera,&n,&error);
	  for(i=0;i<n;i++)
	    printf("\t%s\n",tn[i]);
	  g_free(tn);

	  printf("\nTrigger source: %s\n",arv_camera_get_trigger_source(camera,&error));
	  printf("Trigger sources:\n");
	  tn=arv_camera_dup_available_trigger_sources(camera,&n,&error);
	  for(i=0;i<n;i++)
	    printf("\t%s\n",tn[i]);
	  g_free(tn);

	  printf("\nPixel mode: %s\n",arv_camera_get_pixel_format_as_string(camera,&error));
	  printf("Pixel modes:\n");
	  tn=arv_camera_dup_available_pixel_formats_as_strings(camera,&n,&error);
	  for(i=0;i<n;i++)
	    printf("\t%s\n",tn[i]);
	  g_free(tn);
	}

      if(gain)
	{
	  arv_camera_set_gain_auto(camera,ARV_AUTO_OFF,&error);
	  arv_camera_set_gain(camera,gv,&error);
	}
      
      if(exposure)
	{
	  arv_camera_set_exposure_time_auto(camera,ARV_AUTO_OFF,&error);
	  arv_camera_set_exposure_time(camera,ev,&error);
	}
      
      if(arm)
	{
	  arv_camera_clear_triggers(camera,&error);
	  arv_camera_set_exposure_mode(camera,ARV_EXPOSURE_MODE_TIMED,&error);
	  arv_camera_set_trigger(camera,"Line0",&error);
	  arv_camera_set_pixel_format_from_string(camera,"Mono16",&error);
	  arv_camera_set_acquisition_mode (camera,ARV_ACQUISITION_MODE_SINGLE_FRAME,&error);
	}
      
      if(fname)
	{
	  gv=arv_camera_get_gain(camera,&error);
	  ev=arv_camera_get_exposure_time(camera,&error);
	  arv_camera_get_sensor_size(camera,&w,&h,&error);
	  naxes[0]=w;
	  naxes[1]=h;
	  npix=h*w;
	  snprintf(aux,STRSZ,"%s.fits.gz",fname);
	  unlink(aux);	  	  
	  fits_create_file(&fptr,fname,&status);
	  for(i=0;i<nimg;i++)
	    {
	      buffer=arv_camera_acquisition(camera,0,&error);
	      if(ARV_IS_BUFFER(buffer))
		{
		  fits_create_img(fptr,SHORT_IMG,2,naxes,&status);		  
		  fits_write_key(fptr,TDOUBLE,"GAIN",&gv,"G in dB",&status);
		  fits_write_key(fptr,TDOUBLE,"EXPOSURE",&ev,"Exp. time in us",&status);	      
#if ARAVIS_CHECK_VERSION(0,8,26)
	          data=arv_buffer_get_image_data(buffer,&sz);
#else
	          data=arv_buffer_get_data(buffer,&sz);
#endif	      
		  fits_write_pix(fptr,TUSHORT,fpixels,npix,data,&status);
		  g_clear_object (&buffer);
		  if(cmt)	
		    fits_write_comment(fptr,cmt,&status);
		  fits_write_date(fptr,&status);
		}
	    }

	  //create the jpeg file for the first image by piping a pgm file to cjpeg
	  if(jpg)  
	    {
	      fits_movabs_hdu(fptr,1,NULL,&status);
	      fits_read_pix(fptr,TUSHORT,fpixels,npix,NULL,data,NULL,&status);
	      snprintf(aux,STRSZ,"cjpeg > %s.jpeg", fname);
	      fp=popen(aux,"w");
	      if(fp)		    
		{
		  //old cjpeg can't deal with 16bits gray levels
		  snprintf(aux,STRSZ,"P5\n%ld %ld\n255\n",naxes[0],naxes[1]);
		  fprintf(fp,aux);
		  for(i=1;i<sz;i+=2)
		    pwrite(fileno(fp),data,1,i);
		  pclose(fp);
		}
	    }	      
	  
	  fits_close_file(fptr,&status);
	  if(status)
	    fits_report_error(stderr,status);
	}
      
      g_clear_object (&camera);
    }
  
  return EXIT_SUCCESS;
}
