LOOP

COMMENT
Load MOT, switch off B field

ENDCOMMENT

INIT
Trigger = Off                                                      (0)
Trigger CCD = Off						(1) 
MOT B Field = Off						(14)
shim X = 0.0 mA                                                 (23)
shim Y = 0.0 mA                                                 (24)
shim Z = 0.0 mA                                                 (25)

ENDINIT

INNER
+1s			Ref Cool Freq = 10000000.0 Hz                    (32)
+1ms		AOM Amp = [700]					(41)
+1ms		RAMP Ref Cool Freq TO 11000000.0 Hz IN 5ms (20 STEPS)                  (32) 
+5.1ms	    AOM Amp = [0]					(41)
+100us		Ref Cool Freq = 10000000.0 Hz                    (32)
+2.0ms	    Trigger CCD = On				(1)
+50us		AOM Amp = [700]					(41)
+50us		AOM Amp = [0]					(41)
+20ms		Trigger CCD = Off                                   (1)
+1ms		AOM Amp = [700]					(41)
+20ms		Ref Cool Freq = 10000000.0 Hz                    (32)
ENDINNER

ITERATIONS 20

ENDLOOP
