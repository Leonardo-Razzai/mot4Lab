LOOP

COMMENT
Load MOT, switch off B field

ENDCOMMENT

INIT
Trigger = Off                                                      (0)
Trigger CCD = Off						(1) 
MOT B Field = Off						(14)
shim X = 0.0 mA                                                 (23)
shim Y = 0.0 mA                                                 (24)
shim Z = 0.0 mA                                                 (25)

ENDINIT

INNER
+1s	        Trigger CCD = On				(1)
+1ms		AOM Amp = [700]					(41)
+10ms	    AOM Amp = [0]					(41)
+1ms		    Trigger CCD = Off                                   (1)
+1s		AOM Amp = [700]					(41)
ENDINNER

ITERATIONS 10

ENDLOOP
