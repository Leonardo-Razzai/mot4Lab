LOOP

COMMENT
Load MOT, switch off B field

ENDCOMMENT

INIT
Trigger = Off                                                      (0)
Trigger CCD = Off						(1) 
MOT B Field = Off						(14)
shim X = 0.0 mA                                                 (23)
shim Y = 0.0 mA                                                 (24)
shim Z = 0.0 mA                                                 (25)

ENDINIT

INNER
+2s			Ref Cool Freq = 10000000.0 Hz                    (32)
+1us        Trigger = On				(0)
+50us		RAMP Ref Cool Freq TO 11700000.0 Hz IN 5ms (20 STEPS)                  (32) 
+5.05ms		Ref Cool Freq = 10000000.0 Hz                    (32)
+1s         Trigger = Off				(0)
ENDINNER

ITERATIONS 10

ENDLOOP
