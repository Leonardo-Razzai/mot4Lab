LOOP

COMMENT
Load MOT, switch off B field

ENDCOMMENT

INIT
Trigger = Off                                                      (0)
Trigger CCD = Off						(1) 
MOT B Field = Off						(14)
shim X = 0.0 mA                                                 (23)
shim Y = 0.0 mA                                                 (24)
shim Z = 0.0 mA                                                 (25)

ENDINIT

INNER
+1s		RAMP AOM Amp TO [1000]	IN 100s (10 STEPS)				(41)
+101s     AOM Amp = [100]                                         (41)
ENDINNER

ITERATIONS 1

ENDLOOP
